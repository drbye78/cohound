{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cohound.local/contracts/seam/search.schema.json",
  "title": "POST /v1/search payload",
  "description": "Запрос внешнего поиска и ответ edge (07 §3). Ответ — список кандидатов {url, title, snippet, rank}; это не evidence (I19).",
  "type": "array",
  "items": {"$ref": "#/$defs/item"},
  "$defs": {
    "request": {
      "title": "POST /v1/search request payload",
      "type": "object",
      "additionalProperties": false,
      "required": ["query"],
      "properties": {
        "query": {"type": "string", "minLength": 1},
        "lang": {"type": ["string", "null"]},
        "limit": {"type": "integer", "minimum": 0},
        "phase": {"type": "string"}
      }
    },
    "item": {
      "title": "Кандидат поиска",
      "type": "object",
      "additionalProperties": false,
      "required": ["url"],
      "properties": {
        "url": {"type": "string", "minLength": 1},
        "title": {"type": "string"},
        "snippet": {"type": "string"},
        "rank": {"type": "integer"}
      }
    }
  }
}
