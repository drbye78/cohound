{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cohound.local/contracts/seam/fetch.schema.json",
  "title": "POST /v1/fetch payload",
  "description": "Запрос фетча страницы/документа и ответ edge (07 §3, D2). Запрос несёт три оси: fetch (http|browser), extract (auto|html|document) и strategy (auto|honest|hybrid) плюс опциональный wait_for и валидаторы условного повторного получения (if_none_match/if_modified_since). Сырые байты (raw) — retention; очищенный markdown (text) — результат извлечения. Ответ несёт валидаторы (etag/last_modified) и признак not_modified (304: raw — закэшированное представление). Возвращается контент, не evidence (I19).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "request_id": {"type": "string"},
    "final_url": {"type": "string"},
    "status_code": {"type": ["integer", "null"]},
    "content_type": {"type": ["string", "null"]},
    "fetched_at": {"type": "string"},
    "lang": {"type": ["string", "null"]},
    "etag": {"type": ["string", "null"]},
    "last_modified": {"type": ["string", "null"]},
    "not_modified": {"type": "boolean"},
    "raw": {
      "oneOf": [
        {"$ref": "#/$defs/raw"},
        {"type": "null"}
      ]
    },
    "text": {
      "oneOf": [
        {"$ref": "#/$defs/text"},
        {"type": "null"}
      ]
    },
    "error": {"type": ["string", "null"]}
  },
  "anyOf": [
    {"required": ["raw"]},
    {"required": ["text"]},
    {"required": ["error"]},
    {"required": ["final_url"]}
  ],
  "$defs": {
    "request": {
      "title": "POST /v1/fetch request payload",
      "description": "Запросный payload /v1/fetch: url обязателен; fetch/extract/strategy — опциональные оси (strategy additive, отсутствие = auto); wait_for/lang — строки или null.",
      "type": "object",
      "additionalProperties": false,
      "required": ["url"],
      "properties": {
        "url": {"type": "string", "minLength": 1},
        "fetch": {"enum": ["http", "browser"]},
        "lang": {"type": ["string", "null"]},
        "extract": {"enum": ["auto", "html", "document"]},
        "strategy": {"enum": ["auto", "honest", "hybrid"]},
        "wait_for": {"type": ["string", "null"]},
        "if_none_match": {"type": ["string", "null"]},
        "if_modified_since": {"type": ["string", "null"]}
      }
    },
    "raw": {
      "title": "Сырые байты страницы",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hash": {"type": "string"},
        "size": {"type": "integer"},
        "bytes_b64": {"type": ["string", "null"]},
        "ref": {"type": ["string", "null"]},
        "content": {"type": ["string", "null"]}
      }
    },
    "text": {
      "title": "Очищенный markdown",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "content": {"type": ["string", "null"]},
        "hash": {"type": ["string", "null"]},
        "extractor_version": {"type": ["string", "null"]},
        "page_count": {"type": ["integer", "null"]}
      }
    }
  }
}
