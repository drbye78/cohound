{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cohound.local/contracts/seam/crawl.schema.json",
  "title": "POST /v1/crawl/* payloads",
  "description": "Контракты очереди краула (Phase 3.1): submit (постановка), status (прогресс), cancel (отмена) и collect (забор результатов), плюс poll (опрос фида/канала, Wave 5.1). Все пять операций — POST; каждая имеет собственные request/response в $defs. Ответ collect несёт контент (сырые байты/хэши) и валидаторы условного фетча (etag/last_modified/not_modified), а poll — только ссылки на записи (URL+метаданные); ни то, ни другое не evidence (I19). Планировщик (Wave 3.2) и сервис опроса (Wave 5.1) инъецируются в edge; при отсутствии операция отвечает status=error.",
  "type": "object",
  "oneOf": [
    {"$ref": "#/$defs/submit_response"},
    {"$ref": "#/$defs/status_response"},
    {"$ref": "#/$defs/cancel_response"},
    {"$ref": "#/$defs/collect_response"},
    {"$ref": "#/$defs/poll_response"}
  ],
  "$defs": {
    "submit_request": {
      "title": "POST /v1/crawl/submit request payload",
      "description": "Постановка задания краула: метаданные сессии/прогона и непустой список items. У item оси fetch/extract/strategy/wait_for/lang — как у /v1/fetch (additive).",
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "session_id", "idempotency_key", "profile", "items"],
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "session_id": {"type": "string", "minLength": 1},
        "idempotency_key": {"type": "string", "minLength": 1},
        "profile": {"type": "string", "minLength": 1},
        "user_agent": {"type": "string"},
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/submit_item"}
        }
      }
    },
    "submit_item": {
      "title": "Элемент items запроса crawl/submit",
      "type": "object",
      "additionalProperties": false,
      "required": ["product_id", "url"],
      "properties": {
        "product_id": {"type": "string", "minLength": 1},
        "url": {"type": "string", "minLength": 1},
        "engine": {"type": ["string", "null"]},
        "kind": {"type": ["string", "null"]},
        "fetch": {"enum": ["http", "browser"]},
        "extract": {"enum": ["auto", "html", "document"]},
        "strategy": {"enum": ["auto", "honest", "hybrid"]},
        "wait_for": {"type": ["string", "null"]},
        "lang": {"type": ["string", "null"]},
        "robots": {"type": "boolean"},
        "if_none_match": {"type": ["string", "null"]},
        "if_modified_since": {"type": ["string", "null"]},
        "rate_limit": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "min_s": {"type": "number", "minimum": 0},
            "max_s": {"type": "number", "minimum": 0}
          },
          "required": ["min_s", "max_s"]
        }
      }
    },
    "submit_response": {
      "title": "POST /v1/crawl/submit response payload",
      "type": "object",
      "additionalProperties": false,
      "required": ["job_id", "accepted", "total", "session_id"],
      "properties": {
        "job_id": {"type": "string", "minLength": 1},
        "accepted": {"type": "boolean"},
        "total": {"type": "integer"},
        "session_id": {"type": "string", "minLength": 1}
      }
    },
    "status_request": {
      "title": "POST /v1/crawl/status request payload",
      "type": "object",
      "additionalProperties": false,
      "required": ["job_id"],
      "properties": {
        "job_id": {"type": "string", "minLength": 1}
      }
    },
    "status_response": {
      "title": "POST /v1/crawl/status response payload",
      "description": "Прогресс задания: счётчики по состояниям и наблюдаемые движки/типы.",
      "type": "object",
      "additionalProperties": false,
      "required": ["job_id", "status"],
      "properties": {
        "job_id": {"type": "string", "minLength": 1},
        "status": {"type": "string", "minLength": 1},
        "total": {"type": "integer"},
        "pending": {"type": "integer"},
        "running": {"type": "integer"},
        "fetched": {"type": "integer"},
        "failed": {"type": "integer"},
        "cancelled": {"type": "integer"},
        "engines": {"type": "array", "items": {"type": "string"}},
        "kinds": {"type": "array", "items": {"type": "string"}}
      }
    },
    "cancel_request": {
      "title": "POST /v1/crawl/cancel request payload",
      "type": "object",
      "additionalProperties": false,
      "required": ["job_id"],
      "properties": {
        "job_id": {"type": "string", "minLength": 1}
      }
    },
    "cancel_response": {
      "title": "POST /v1/crawl/cancel response payload",
      "type": "object",
      "additionalProperties": false,
      "required": ["job_id", "status", "cancelled"],
      "properties": {
        "job_id": {"type": "string", "minLength": 1},
        "status": {"const": "cancelled"},
        "cancelled": {"type": "integer"}
      }
    },
    "collect_request": {
      "title": "POST /v1/crawl/collect request payload",
      "description": "Постраничный забор результатов: job_id, опциональные cursor (непрозрачный маркер) и limit (размер страницы).",
      "type": "object",
      "additionalProperties": false,
      "required": ["job_id"],
      "properties": {
        "job_id": {"type": "string", "minLength": 1},
        "cursor": {"type": ["string", "null"]},
        "limit": {"type": ["integer", "null"]}
      }
    },
    "collect_response": {
      "title": "POST /v1/crawl/collect response payload",
      "description": "Страница результатов: items (контент, не evidence — I19), следующий cursor и признак завершения.",
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "next_cursor", "done"],
      "properties": {
        "items": {
          "type": "array",
          "items": {"$ref": "#/$defs/collect_item"}
        },
        "next_cursor": {"type": ["string", "null"]},
        "done": {"type": "boolean"}
      }
    },
    "collect_item": {
      "title": "Элемент items ответа crawl/collect",
      "type": "object",
      "additionalProperties": false,
      "required": ["product_id", "url"],
      "properties": {
        "product_id": {"type": "string", "minLength": 1},
        "url": {"type": "string", "minLength": 1},
        "status": {"type": ["string", "null"]},
        "engine": {"type": ["string", "null"]},
        "kind": {"type": ["string", "null"]},
        "http_status": {"type": ["integer", "null"]},
        "content_type": {"type": ["string", "null"]},
        "fetched_at": {"type": ["string", "null"]},
        "content_hash": {"type": ["string", "null"]},
        "final_url": {"type": ["string", "null"]},
        "etag": {"type": ["string", "null"]},
        "last_modified": {"type": ["string", "null"]},
        "not_modified": {"type": "boolean"},
        "raw": {
          "oneOf": [
            {"$ref": "#/$defs/raw"},
            {"type": "null"}
          ]
        },
        "error": {"type": ["string", "null"]}
      }
    },
    "raw": {
      "title": "Сырые байты фетча (retention, I19)",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hash": {"type": "string"},
        "size": {"type": "integer"},
        "bytes_b64": {"type": ["string", "null"]}
      }
    },
    "poll_request": {
      "title": "POST /v1/crawl/poll request payload",
      "description": "Опрос каталогового документа (Wave 5.1/D3): url и его вид (feed — RSS/Atom/RDF-XML, channel — список ссылок/JSON, sitemap — sitemap.xml/sitemap.xml.gz с urlset/sitemapindex). Оси fetch/extract/strategy/wait_for — как у /v1/fetch (additive). params — опциональные caps: since (строка) и limit (целое).",
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "kind"],
      "properties": {
        "url": {"type": "string", "minLength": 1},
        "kind": {"enum": ["feed", "channel", "sitemap"]},
        "fetch": {"enum": ["http", "browser"]},
        "extract": {"enum": ["auto", "html", "document"]},
        "strategy": {"enum": ["auto", "honest", "hybrid"]},
        "wait_for": {"type": ["string", "null"]},
        "params": {"$ref": "#/$defs/poll_params"}
      }
    },
    "poll_params": {
      "title": "params запроса crawl/poll",
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "since": {"type": ["string", "null"]},
        "limit": {"type": ["integer", "null"]}
      }
    },
    "poll_entry": {
      "title": "Ссылка на запись ответа crawl/poll",
      "description": "Только ссылка (URL+метаданные), без байтов (I19).",
      "type": "object",
      "additionalProperties": false,
      "required": ["url"],
      "properties": {
        "url": {"type": "string", "minLength": 1},
        "guid": {"type": ["string", "null"]},
        "published_at": {"type": ["string", "null"]},
        "title": {"type": ["string", "null"]}
      }
    },
    "poll_response": {
      "title": "POST /v1/crawl/poll response payload",
      "description": "Ссылки на записи каталогового документа: entries, count и признак усечения по limit/max_entries.",
      "type": "object",
      "additionalProperties": false,
      "required": ["entries", "count", "truncated"],
      "properties": {
        "entries": {
          "type": "array",
          "items": {"$ref": "#/$defs/poll_entry"}
        },
        "count": {"type": "integer"},
        "truncated": {"type": "boolean"}
      }
    }
  }
}
