          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/RequestEnvelope"
                  },
                  {
                    "properties": {
                      "payload": {
                        "$ref": "#/components/schemas/FetchRequest"
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Сырые байты/очищенный текст; контент, не evidence (I19).",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Envelope"
                    },
                    {
                      "properties": {
                        "payload": {
                          "$ref": "#/components/schemas/FetchResponse"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Не аутентифицирован: отсутствуют/невалидны креденшелы. Возвращается только при настроенной аутентификации (auth.mode != none).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          },
          "403": {
            "description": "Идентичность подтверждена, но у субъекта нет scope операции. Возвращается только при настроенной аутентификации (auth.mode != none).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          },
          "413": {
            "description": "Тело запроса превышает max_body_bytes (Content-Length отвергается до чтения; соединение закрывается — Connection: close).",
            "content": {
              "application/json": {
