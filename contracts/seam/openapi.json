{
  "openapi": "3.1.0",
  "info": {
    "title": "coHound DMZ seam API",
    "version": "1",
    "description": "Единственный канал core↔edge (application-layer firewall, L7). Ядро (Z0) инициирует, edge (Z1/DMZ) отвечает; обратного инициирования нет (07 §3/§5). Конверт: {schema_version, request_id, status, payload, error}. schema_version=\"1\"; несовместимое изменение контракта — версионная граница §13 (07 §8.3). Схемы публикуются для написания DLP/IDS/IDP-политик по контракту (07 §8); аттестация против конкретных средств — вне рамок проекта.",
    "x-schema-version": "1",
    "x-auth-enforcement": "auth/audit/body-limit are enforced only when configured; auth.mode=none is allowed on loopback only; a non-loopback bind without auth refuses to start (fail-fast)."
  },
  "servers": [
    {
      "url": "https://edge.internal:8443",
      "description": "DMZ app-port (mTLS; без certificate pinning — L7/TLS-инспекция допускается, 07 §8.1)"
    }
  ],
  "components": {
    "parameters": {
      "RequestId": {
        "name": "X-Request-Id",
        "in": "header",
        "required": true,
        "description": "Корреляция вызова (совпадает с request_id конверта; SIEM/IDS, 07 §8.1/§8.4).",
        "schema": {
          "type": "string",
          "minLength": 1
        }
      },
      "SchemaVersion": {
        "name": "X-Schema-Version",
        "in": "header",
        "required": true,
        "description": "Версия контракта шва; несовпадение — версионная граница §13.",
        "schema": {
          "const": "1"
        }
      }
    },
    "schemas": {
      "Envelope": {
        "$ref": "envelope.schema.json"
      },
      "RequestEnvelope": {
        "$ref": "envelope.schema.json#/$defs/request"
      },
      "FetchRequest": {
        "$ref": "fetch.schema.json#/$defs/request"
      },
      "FetchResponse": {
        "$ref": "fetch.schema.json"
      },
      "SearchRequest": {
        "$ref": "search.schema.json#/$defs/request"
      },
      "SearchResponse": {
        "$ref": "search.schema.json"
      },
      "RegistryRequest": {
        "$ref": "registry.schema.json#/$defs/request"
      },
      "RegistryResponse": {
        "$ref": "registry.schema.json"
      },
      "CapabilitiesResponse": {
        "$ref": "capabilities.schema.json"
      },
      "HealthResponse": {
        "$ref": "health.schema.json"
      },
      "CrawlSubmitRequest": {
        "$ref": "crawl.schema.json#/$defs/submit_request"
      },
      "CrawlSubmitResponse": {
        "$ref": "crawl.schema.json#/$defs/submit_response"
      },
      "CrawlStatusRequest": {
        "$ref": "crawl.schema.json#/$defs/status_request"
      },
      "CrawlStatusResponse": {
        "$ref": "crawl.schema.json#/$defs/status_response"
      },
      "CrawlCancelRequest": {
        "$ref": "crawl.schema.json#/$defs/cancel_request"
      },
      "CrawlCancelResponse": {
        "$ref": "crawl.schema.json#/$defs/cancel_response"
      },
      "CrawlCollectRequest": {
        "$ref": "crawl.schema.json#/$defs/collect_request"
      },
      "CrawlCollectResponse": {
        "$ref": "crawl.schema.json#/$defs/collect_response"
      },
      "CrawlPollRequest": {
        "$ref": "crawl.schema.json#/$defs/poll_request"
      },
      "CrawlPollResponse": {
        "$ref": "crawl.schema.json#/$defs/poll_response"
      }
    },
    "securitySchemes": {
      "mtls": {
        "type": "mutualTLS",
        "description": "Клиентский сертификат корпоративного PKI (workload-identity, 07 §8.2). TLS-handshake завершается на доверенном прокси; edge получает уже проверенный субъект. Применяется только при auth.mode=mtls."
      },
      "bearerJWT": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "OIDC/JWT bearer от корпоративного IDP; проверяются подпись, iss, aud, exp и scopes (07 §8.2). Применяется только при auth.mode=oidc."
      }
    }
  },
