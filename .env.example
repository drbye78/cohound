# coHound — шаблон переменных окружения и внешних ключей (НЕ коммитить секреты!).
#
# Скопируйте в `.env`, заполните значения и экспортируйте в среду процесса
# (`set -a; . ./.env; set +a`) либо передайте через секрет-хранилище развёртывания.
# Назначение/обязательность/fallback каждой переменной — docs/architecture/03-data-config-cli.md §D.6.
#
# ВАЖНО (профиль split, 07): эгрессионные ключи внешнего поиска (YANDEX_*, GLM_SEARCH_API_KEY)
# в профиле `split` живут ТОЛЬКО в edge;
# ядро ходит за кандидатами через /v1/*-шов и их не читает. Оценщик (Ш6, I18) веб-тула не имеет.

# --- LLM-разведка (hound passport-scout, Ш2) ---------------------------------
# base_url [OI]-совместимого API внутреннего корпоративного периметра;
# пусто → не сконфигурировано (внешние хосты не используются)
COHOUND_LLM_BASE_URL=
# ключ доступа к внутреннему LLM-API (единственный источник; никаких внешних фолбэков)
COHOUND_LLM_API_KEY=
# model_id; пусто → дефолт deepseek-v4.1-flash:cxbc
COHOUND_LLM_MODEL=
# механизм декодирования: none | json_object | json_schema (пусто → json_object)
COHOUND_LLM_DECODER=
# таймаут запроса, с (>0; пусто → 120.0)
COHOUND_LLM_TIMEOUT=
# максимум токенов ответа (>0; пусто → 4096)
COHOUND_LLM_MAX_TOKENS=
# активный LLM-слот: cheap | flagship (пусто → deploy.llm.slot / дефолт cheap).
# Оба слота по умолчанию указывают на deepseek-v4.1-flash:cxbc; модели доступны через
# [OI]-совместимый API внутреннего корпоративного периметра — это НЕ self-host инсталляция
# (vLLM/SGLang — возможный бэкенд периметра, не наш стек/зависимость).
COHOUND_LLM_SLOT=

# --- Scout / обёртка CLI -----------------------------------------------------
# краулер passport-scout: http (дефолт) | scrapy (SPA/JS; extra crawl)
COHOUND_SCOUT_CRAWLER=
# отключить автоперезапуск hound.py в проектной .venv (например, 1)
COHOUND_NO_REEXEC=
# служебный предохранитель от зацикливания перезапуска (ставит hound.py; не задавать вручную)
COHOUND_REEXEC=

# --- Внешний поиск (SERP), hound discover (Ш5) -------------------------------
# Yandex Search API (нужны оба; иначе адаптер недоступен, I19)
YANDEX_SEARCH_API_KEY=
YANDEX_FOLDER_ID=
# режим Yandex: async (дефолт) | sync
YANDEX_SEARCH_MODE=
# GLM web-search (ключ обязателен для адаптера)
GLM_SEARCH_API_KEY=

# --- Раскладка операционных каталогов (03 §A.1) ------------------------------
# Единый корень: относительные пути ниже считаются от него (пусто → от CWD).
COHOUND_HOME=
# Путь к paths.yaml (пусто → config/paths.yaml; отсутствие файла — дефолты).
COHOUND_PATHS_FILE=
# Переопределение отдельных каталогов (пусто → значение из paths.yaml либо дефолт).
# Приоритет: CLI-флаг > env > paths.yaml > дефолт.
COHOUND_PACKAGES_DIR=
COHOUND_PASSPORTS_DIR=
COHOUND_RUNS_DIR=
COHOUND_INDEX_STORE_DIR=
COHOUND_CORPUS_RAW_DIR=
COHOUND_CACHE_DIR=
COHOUND_REGISTRIES_DIR=
COHOUND_REPORTS_DIR=
