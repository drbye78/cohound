# coHound — шаблон переменных окружения и внешних ключей (НЕ коммитить секреты!).
#
# Скопируйте в `.env`, заполните значения и экспортируйте в среду процесса
# (`set -a; . ./.env; set +a`) либо передайте через секрет-хранилище развёртывания.
# Назначение/обязательность/fallback каждой переменной — docs/architecture/03-data-config-cli.md §D.6.
#
# ВАЖНО (профиль split, 07): эгрессионные ключи внешнего поиска (YANDEX_*, GLM_SEARCH_API_KEY,
# GOOGLE_*, OPEN_WEBSEARCH_*, DUCKDUCKGO_BACKEND) в профиле `split` живут ТОЛЬКО в edge;
# ядро ходит за кандидатами через /v1/*-шов и их не читает. Оценщик (Ш6, I18) веб-тула не имеет.

# --- LLM-разведка (hound passport-scout, Ш2) ---------------------------------
# base_url openai-совместимого сервера; пусто → дефолт https://plusvibeapi.ru/v1
COHOUND_LLM_BASE_URL=
# ключ LLM; пусто → фолбэк PLUSVIBEAPI_API_KEY
COHOUND_LLM_API_KEY=
# фолбэк ключа контура (уже может присутствовать в среде развёртывания)
PLUSVIBEAPI_API_KEY=
# model_id; пусто → дефолт deepseek-v4.1-flash:cxbc
COHOUND_LLM_MODEL=
# механизм декодирования: none | json_object | json_schema (пусто → json_object)
COHOUND_LLM_DECODER=
# таймаут запроса, с (>0; пусто → 120.0)
COHOUND_LLM_TIMEOUT=
# максимум токенов ответа (>0; пусто → 4096)
COHOUND_LLM_MAX_TOKENS=

# --- Scout / обёртка CLI -----------------------------------------------------
# краулер passport-scout: http (дефолт) | scrapy (SPA/JS; extra crawl)
COHOUND_SCOUT_CRAWLER=
# отключить автоперезапуск hound.py в проектной .venv (например, 1)
COHOUND_NO_REEXEC=
# служебный предохранитель от зацикливания перезапуска (ставит hound.py; не задавать вручную)
COHOUND_REEXEC=

# --- Внешний поиск (SERP), hound discover (Ш5) -------------------------------
# Yandex Search API (нужны оба; иначе адаптер недоступен, I19)
YANDEX_SEARCH_API_KEY=
YANDEX_FOLDER_ID=
# режим Yandex: async (дефолт) | sync
YANDEX_SEARCH_MODE=
# GLM web-search (ключ обязателен для адаптера)
GLM_SEARCH_API_KEY=
# Google Custom Search Engine (нужны ключ + cx; иначе адаптер недоступен, I19)
GOOGLE_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_CSE_ID=
GOOGLE_SEARCH_ENGINE_ID=
# движок библиотеки ddgs (пусто → duckduckgo)
DUCKDUCKGO_BACKEND=
# утилита open-websearch: путь/имя бинаря и движок (пусто → open-websearch / duckduckgo)
OPEN_WEBSEARCH_BIN=
OPEN_WEBSEARCH_ENGINE=
