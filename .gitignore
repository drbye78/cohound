# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Операционные артефакты прогонов (не версионируется).
# Штатное место этих каталогов — вне репозитория (03 §A.1.2: COHOUND_HOME + paths.yaml);
# строки ниже остаются, потому что без настроенной раскладки дефолт — относительный путь,
# и тогда артефакты появляются в дереве. Убрать их отсюда значило бы «настроил раскладку —
# и получил 12 GB в git status».
runs/
runs/*/sqlite.db
runs/*/*.db-wal
runs/*/*.db-shm
reports/*.xlsx
reports/*.csv

# Индексные сборки (.npy-шарды) — иммутабельны, но велики
index_store/

# Сырой корпус (байты страниц) — retention локально
corpus_raw/

# Глобальный content-addressed кэш (R7, ADR 0016): SERP + HTTP — операционный
cache/

# Межпрогонный кэш вердиктов оценщика (Ф3) — операционный, не версионируется
eval_cache/
extract_cache/

# Межпрогонный кэш векторов эмбеддинга (почанково) — операционный, не версионируется
embed_cache/

# Durable per-product состояние онбординга (09 §4.1) — операционное, не версионируется
state/

# Секреты окружения (шаблон без значений — .env.example, коммитится)
.env

# Прочее
*.log
.DS_Store

# Покрытие и property-тесты (артефакты, не версионируются)
.coverage
.coverage.*
htmlcov/
.hypothesis/

# Deepwork session state (git-local)
.slim/deepwork/

# Локальный артефакт CodeGraphContext MCP (автогенерация, не зависимость проекта)
.cgcignore

# Намеренно untracked (решение владельца): план эволюции краула не коммитится.
docs/architecture/08-crawl-platform-evolution-plan.md

# Вывод сборки Hugo для docs/user-guide (генерируется локально; в дереве живут источники)
docs/user-guide/public/
docs/user-guide/.hugo_build.lock
